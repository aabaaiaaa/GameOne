    { "name": "Great Crater", "at": [7, -22], "diameter": 1000, "depth": 120, "rimHeight": 40, "rays": 14 },
    { "name": "Lesser Crater", "at": [18, 23], "diameter": 625, "depth": 80, "rimHeight": 26, "rays": 10 }
  ],
  // The canyon: a rough crescent well south of them, its middle about 30° S (due south of its

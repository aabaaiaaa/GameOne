  // spot (over 1.5 km, behind its horizon).
  "tail": {
    "path": [[42, 140], [30, 160], [12, 160], [0, 175], [-5, 195], [-18, 205], [-12, 228]],
    "tipHeight": 10, "baseHeight": 320, "tipWidth": 60, "baseWidth": 500, "wander": 40,
    "mountainHeight": 800, "mountainRadius": 1500, "craterDiameter": 300, "craterDepth": 130

  "seas": [
    // Each sea's waves (from crest to trough of its biggest) and its water's colours (over the shelf
    // and over deep water) give it its character: the warm seas calm, the icy ones roughest.
    // The sea under the launch path: past 100 m deep 5 km east of the pad.
    { "name": "Sunrise Sea", "at": [0, 25], "kind": "warm", "depth": 320, "shelf": 1000,
      "waves": 1.0, "shallow": [0.18, 0.62, 0.60], "deep": [0.03, 0.15, 0.30] },
    { "name": "Amber Gulf", "at": [-28, -58], "kind": "warm", "depth": 90, "shelf": 700, "banks": 0.6,
      "waves": 0.6, "shallow": [0.32, 0.62, 0.50], "deep": [0.06, 0.22, 0.28] },
    { "name": "Coral Sea", "at": [-6, 184], "kind": "warm", "depth": 160, "shelf": 800, "banks": 0.5,
      "waves": 0.8, "shallow": [0.08, 0.76, 0.68], "deep": [0.05, 0.09, 0.42] },
    { "name": "Western Ocean", "at": [-30, -130], "kind": "temperate", "depth": 500, "shelf": 450,
      "waves": 1.8, "shallow": [0.22, 0.48, 0.48], "deep": [0.03, 0.10, 0.21] },
    { "name": "Grey Sea", "at": [42, 95], "kind": "temperate", "depth": 360, "shelf": 600,
      "waves": 1.6, "shallow": [0.30, 0.48, 0.44], "deep": [0.07, 0.12, 0.17] },
    // The icy seas are frozen round their centres: a sheet of pack ice out to about "pack" metres,
    // its edge ragged, then a band of floes "floes" metres wide, which damp the swell.
    { "name": "Boreal Sea", "at": [80, 0], "kind": "icy", "depth": 420, "shelf": 400,
      "waves": 2.4, "shallow": [0.40, 0.52, 0.56], "deep": [0.07, 0.11, 0.17], "ice": { "pack": 1100, "floes": 500 } },
    { "name": "Austral Sea", "at": [-82, 150], "kind": "icy", "depth": 460, "shelf": 450,
      "waves": 2.6, "shallow": [0.44, 0.55, 0.61], "deep": [0.04, 0.07, 0.13], "ice": { "pack": 1300, "floes": 600 } }
  ],

  "ranges": [
    // Inland of the pad: its crest ~2.5 km west, tall enough to show over the horizon, and in the
    // way of a return from orbit, which comes in from the west.
    { "name": "Westwall", "path": [[24, -12], [12, -14], [2, -14.5], [-8, -15], [-20, -13], [-28, -10]], "height": 1650, "width": 1800 },
    { "name": "Spine", "path": [[40, -60], [25, -72], [8, -82], [-10, -84]], "height": 1100, "width": 2600 },
    { "name": "Highcrest", "path": [[22, 62], [10, 80], [-6, 96], [-22, 110], [-34, 116]], "height": 1700, "width": 2800 },
    { "name": "Frostspine", "path": [[50, 150], [60, 175], [56, 205], [46, 222]], "height": 1750, "width": 2800 },
    { "name": "Southwall", "path": [[-60, -60], [-64, -30], [-66, 0], [-64, 20]], "height": 1300, "width": 2400 },
    { "name": "Sentinel Hills", "path": [[28, -150], [15, -145], [0, -140]], "height": 950, "width": 2000 }
  ],

  "deserts": { "maxLatitude": 30, "minDistanceFromSea": 1500, "maxHeight": 450, "coverage": 0.6 },
  "snow": { "minLatitude": 56, "minHeight": 1150 },

  // The pad, the near landing zone and the test pads take their places from Scene; only their sizes are here.
  "sites": [
    { "name": "Launch pad", "radius": 90, "blend": 160 },
    { "name": "Landing zone", "radius": 60, "blend": 160 },
    // The other launch sites' pads and zones: levelled down to the highest ground under them, no
    // further than the map's ~15 m texels need to keep it out of their tops (a texel past the
    // footprint), so a mountain site keeps its drop; their foundations reach down to the rest.
    { "name": "Far pad", "radius": 40, "blend": 15 },
    { "name": "Far zone", "radius": 35, "blend": 15 },
    // The test range: six tilted pads in a row (see Scene.TestPads), each levelled under its plinth.
    { "name": "Test pads", "radius": 20, "blend": 120 }
  ],

  "erosion": { "iterations": [30, 30, 20, 10], "incision": 1.5, "channelArea": 40000, "diffusion": 0.05, "talus": 40 }
}

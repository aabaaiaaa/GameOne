    { "name": "Southreach", "outline": [
      [-50, -70], [-54, -58], [-50, -48], [-52, -30], [-58, -22], [-55, -10], [-50, 2], [-52, 10],
      [-56, 28], [-64, 34], [-70, 30], [-72, 18], [-75, 0], [-74, -30], [-72, -55], [-64, -78], [-56, -82] ] },
    { "name": "Sentinel", "outline": [
      [-8, -160], [6, -166], [22, -164], [34, -154], [36, -140], [26, -128], [12, -124], [0, -130], [-10, -142] ] },
    { "name": "Dawn Isle", "outline": [ [20, 18], [25, 20], [26, 26], [21, 28], [18, 23] ] },
    { "name": "Coral Isle", "outline": [ [-14, 166], [-12, 172], [-16, 176], [-20, 172], [-19, 167] ] },
    { "name": "Reef Isle", "outline": [ [-24, 182], [-22, 188], [-26, 192], [-30, 188], [-28, 183] ] },

// The planet's layout: the large shapes, placed by hand; TerrainGen adds the detail and erodes it.
// Positions are [latitude, longitude] in degrees (the pad at [0, 0], east +longitude, north
// +latitude); sizes and heights in metres. See README.md for every field. After editing, run:
//   dotnet run --project tools/TerrainGen -c Release -- tools/TerrainGen/layout.json src/GameOne/Assets/terrain.bin.gz
{
  "seed": 1961,
  "resolution": 1024,

  "coast": { "warp": 900, "warpWavelength": 6000, "roughness": 1300, "roughWavelength": 6000, "cliffs": 0.3, "cliffHeight": 45, "calmRadius": 4000 },
  "relief": {
    "coastRise": 42, "coastRiseLength": 260,
    "hills": 90, "hillWavelength": 2200,
    "plateaus": 240, "plateauWavelength": 7000,
    "roughness": 0.18, "calmRadius": 1800
  },

  "land": [

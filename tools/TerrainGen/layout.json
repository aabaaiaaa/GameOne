    { "name": "Westland", "outline": [
      [-6, 2.3], [-2, 1.8], [0, 1.7], [3, 1.7], [7, 3.2], [12, 7], [17, 5], [20, 0], [22, -6], [27, -4],
      [33, -2], [38, -8], [42, -16], [50, -22], [56, -30], [54, -38], [47, -42], [46, -52], [50, -62],
      [47, -72], [40, -78], [36, -90], [30, -96], [20, -96], [14, -104], [6, -112], [-2, -108], [-4, -100],
      [-12, -98], [-22, -94], [-30, -88], [-40, -86], [-46, -78], [-40, -74],
      // the Amber Gulf, cut in from the south
      [-34, -72], [-24, -70], [-14, -64], [-14, -54], [-22, -48], [-32, -46],
      [-38, -42], [-38, -36], [-34, -28], [-30, -20], [-24, -14], [-20, -6], [-14, -2], [-10, 1] ] },
    { "name": "Eastland", "outline": [
      [28, 44], [32, 54], [30, 64], [34, 72], [28, 80], [22, 92], [16, 98], [18, 108], [10, 114], [6, 118],
      [-4, 130], [-10, 140], [-18, 138], [-28, 134], [-36, 132], [-40, 124], [-48, 118], [-46, 108],
      [-38, 104], [-40, 96], [-36, 88], [-30, 74], [-24, 70], [-20, 62], [-12, 58], [-10, 52], [0, 46],

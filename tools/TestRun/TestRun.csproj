<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the normal test suite split across several dotnet test processes at once (each its own
    Jolt, which is process-wide), and keeps the record of test times (tests/GameOne.Tests/TestTimes.json).
    See README.md. The tests reference it for its arithmetic and for the machine's key, shared
    with the short performance tests' baseline.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TestRun</RootNamespace>
  </PropertyGroup>

</Project>
